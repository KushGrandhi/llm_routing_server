# Copy to deploy/.env on the server and fill in real values. Never commit deploy/.env.

# Public domain: Caddy serves llm.$DOMAIN
DOMAIN=kgai.pro

# Gateway authentication (comma-separated keys clients send as Bearer tokens)
GATEWAY_API_KEYS=replace-with-a-long-random-key

# Provider keys (fill in the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# Cache (Redis is set by docker-compose.yml)
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=3600

# Rate limiting (storage is Redis via docker-compose.yml)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100 per minute

# Logging and metrics
REQUEST_LOGGING_ENABLED=true
METRICS_ENABLED=true
LOG_LEVEL=INFO

# Request defaults
DEFAULT_TIMEOUT_SECONDS=60
DEFAULT_MAX_RETRIES=2

# Gunicorn workers (each loads litellm; keep at 2 on a shared 1.9 GB host)
GUNICORN_WORKERS=2
